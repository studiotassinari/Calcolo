<UserControl x:Class="STA.Calcolo.Desktop.Views.SteelProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MasonryEditors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><StackPanel Margin="0,0,0,2"><TextBlock Text="PROFILO DELLE COLONNE" Style="{StaticResource SectionLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Profilo OPPO" FontSize="11" Margin="0,0,0,2"/><ComboBox x:Name="ProfileSelector" Style="{x:Null}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Id" StaysOpenOnEdit="True" ItemsSource="{Binding Profiles}" DisplayMemberPath="Id" Text="{Binding SelectedId,UpdateSourceTrigger=PropertyChanged}" Background="#FFFFD6" Foreground="#192845" BorderBrush="#B8CDD1" Padding="7,5" MinHeight="31" ToolTip="Digita il profilo, per esempio HEA 140, oppure scegli dall’elenco."/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Jx asse forte [cm⁴]" FontSize="11" Margin="0,0,0,2"/><TextBox Text="{Binding Model.Jx,Mode=OneWay,StringFormat=N2}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Wx elastico [cm³]" FontSize="11" Margin="0,0,0,2"/><TextBox Text="{Binding Model.Wx,Mode=OneWay,StringFormat=N2}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid></StackPanel></UserControl>