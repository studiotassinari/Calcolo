<Window x:Class="STA.Calcolo.Desktop.Views.RetainingWallWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:STA.Calcolo.Desktop.Controls"
 Title="TA-Calcolo · Muro di sostegno" Width="1480" Height="960" MinWidth="980" MinHeight="700"
 Language="it-IT" FontFamily="/STA.Calcolo.Desktop;component/Assets/Brand/#Acherus Grotesque" FontSize="13"
 Foreground="#192845" Background="#F3F6F6" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Tassinari.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <!-- Gli editor riprendono etichette, sfondo giallo e pannelli del modulo Muratura. -->
  <DataTemplate x:Key="WallField"><StackPanel Margin="0,0,12,10"><TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" Foreground="#526778" Margin="0,0,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" MinHeight="36" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Error}"/><TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0"/></Grid></StackPanel></DataTemplate>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/></Style>
 </ResourceDictionary></Window.Resources>
 <DockPanel x:Name="WallLayout" Margin="24" Background="#F3F6F6">
  <StackPanel DockPanel.Dock="Top">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Muro di sostegno" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="TA-Calcolo · Geometria, terreno e azione sismica" Foreground="#526778" Margin="0,5,0,14"/></StackPanel><Image Grid.Column="1" Source="/STA.Calcolo.Desktop;component/Assets/Brand/Logo.png" Stretch="Uniform" Margin="12,0,0,14"/></Grid>
   <WrapPanel><Button Content="Carica esempio" Command="{Binding ExampleCommand}"/><Button Content="Apri progetto" Command="{Binding OpenCommand}"/><Button Content="Salva progetto" Command="{Binding SaveCommand}"/><Button Content="Salva .mdst" Command="{Binding SaveMdstCommand}"/><Button Content="Calcola" Command="{Binding CalculateCommand}" Background="#192845" BorderBrush="#192845"/><Button Content="Esporta risultati" Command="{Binding ExportCommand}"/><Button Content="Esporta JSON" Command="{Binding ExportJsonCommand}"/></WrapPanel>
   <UniformGrid Columns="3" Margin="0,6,0,0">
    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,10,10"><StackPanel><TextBlock Text="Area della sezione del muro" FontSize="12"/><TextBlock Text="{Binding AreaText}" FontSize="25" Margin="0,5,0,0"/><TextBlock Text="Geometria aggiornata in tempo reale" Foreground="#526778" FontSize="11"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,10,10"><StackPanel><TextBlock Text="Mstab / Mrib · Statica" FontSize="12"/><TextBlock Text="{Binding StaticText}" FontSize="25" Margin="0,5,0,0"/><TextBlock Text="Rapporto del motore originale" Foreground="#526778" FontSize="11"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="Mstab / Mrib · Sisma" FontSize="12"/><TextBlock Text="{Binding SeismicText}" FontSize="25" Margin="0,5,0,0"/><TextBlock Text="Rapporto del motore originale" Foreground="#526778" FontSize="11"/></StackPanel></Border>
   </UniformGrid>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#EAF0F1" Margin="0,10,0,0"><TextBlock Text="{Binding Status}" Foreground="#526778" TextWrapping="Wrap"/></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="390" MinWidth="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="470"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Progetto" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome del progetto" FontSize="11" Margin="0,10,0,4"/><TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome del progetto"/></StackPanel></Border>
    <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Padding="12"><StackPanel><TextBlock Text="{Binding Title}" Background="#192845" Foreground="White" Padding="10" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource WallField}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
   <TabControl x:Name="WallTabs" Grid.Column="2" Foreground="#192845" Background="White" BorderBrush="#D6E0E2">
    <TabItem Header="Sezione del muro"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Geometria e livelli del terreno" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Quote in metri · asse X verso destra, asse Y verso l'alto" Foreground="#526778" Margin="0,5,0,8" TextWrapping="Wrap"/></StackPanel>
     <ui:RetainingWallDrawing x:Name="WallFigure" Grid.Row="1" Geometry="{Binding Geometry}" Result="{Binding Result}" MinHeight="240" ClipToBounds="True"/>
     <StackPanel Grid.Row="2"><WrapPanel Margin="0,6,0,10"><TextBlock Text="■ Muro" Foreground="#135F6E" Margin="0,0,16,0"/><TextBlock Text="■ Terreno" Foreground="#7B6341" Margin="0,0,16,0"/><TextBlock Text="━ Falda" Foreground="#226BA0" Margin="0,0,16,0"/><TextBlock Text="■ Spinta statica" Foreground="#A35B18"/></WrapPanel><Border Background="#FFF5E5" BorderBrush="#BC8135" BorderThickness="3,0,0,0" Padding="10"><TextBlock Text="Motore originale: rapporti e componenti di confronto. Consultare le note prima dell'utilizzo; non è una verifica normativa completa." TextWrapping="Wrap" FontSize="12"/></Border></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Risultati"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Statica e sisma" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ResultStatus}" Foreground="#526778" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel><DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Grandezza" Binding="{Binding Label}" Width="2.5*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Statica" Binding="{Binding Static}" Width="*" MinWidth="100"/><DataGridTextColumn Header="Sisma" Binding="{Binding Seismic}" Width="*" MinWidth="90"/><DataGridTextColumn Header="Unità" Binding="{Binding Unit}" Width="0.8*" MinWidth="80"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="Note di calcolo"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Ipotesi e limiti del motore" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding Notes}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF5E5" BorderBrush="#BC8135" BorderThickness="3,0,0,0" Padding="12" Margin="0,0,0,12"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="I file .mdst mantengono le chiavi del programma originale. Il formato JSON conserva anche il nome del progetto. Ogni modifica invalida i risultati, che devono essere ricalcolati prima dell'esportazione." TextWrapping="Wrap" Foreground="#526778" LineHeight="21"/></StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</Window>
