<Window x:Class="STA.Calcolo.Desktop.Views.GeoPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:STA.Calcolo.Desktop.Views"
 Title="TA-Calcolo · Scelta geografica del sito" Width="1100" Height="760" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner"
 Language="it-IT" FontFamily="/STA.Calcolo.Desktop;component/Assets/Brand/#Acherus Grotesque" FontSize="12.5"
 Foreground="#192845" Background="#F3F6F6" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Tassinari.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,3"/></Style>
 </ResourceDictionary></Window.Resources>
 <!-- Ricerca, mappa e coordinate sono legate al GeoPickerViewModel; la conferma restituisce lat/lon al chiamante. -->
 <DockPanel Margin="12">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Indirizzo da cercare" ToolTip="Indirizzo, località o comune (Italia)">
    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
   </TextBox>
   <Button Grid.Column="1" Content="Cerca indirizzo" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
  </Grid>
  <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Latitudine [°]" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Grid.Column="1" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Grid.Column="2" Text="Longitudine [°]" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBox Grid.Column="3" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="#526778" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/>
   <Button x:Name="ConfirmLocationButton" Grid.Column="5" Content="Usa questo sito" Command="{Binding ConfirmCommand}" Background="#192845" BorderBrush="#192845"/>
   <Button Grid.Column="6" Content="Annulla" Command="{Binding CancelCommand}"/>
  </Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Risultati della ricerca" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Bottom" Text="Ricerca: Nominatim © OpenStreetMap contributors. Una ricerca per richiesta, solo in Italia." TextWrapping="Wrap" FontSize="10.5" Foreground="#526778" Margin="0,6,0,0"/>
    <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,4"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="{Binding CoordinatesText}" FontWeight="SemiBold" Foreground="#135F6E" Margin="0,0,0,4"/>
    <local:GeographicMapView x:Name="PickerMap" Grid.Row="1" Location="{Binding Location, Mode=TwoWay}" MinHeight="320"/>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
