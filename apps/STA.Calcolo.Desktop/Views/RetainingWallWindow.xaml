<Window x:Class="STA.Calcolo.Desktop.Views.RetainingWallWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:STA.Calcolo.Desktop.Controls"
 Title="TA-Calcolo · Muro di sostegno" Width="1440" Height="900" MinWidth="980" MinHeight="640"
 Language="it-IT" FontFamily="/STA.Calcolo.Desktop;component/Assets/Brand/#Acherus Grotesque" FontSize="12.5"
 Foreground="#192845" Background="#F3F6F6" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Tassinari.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <!-- Pulsanti della barra: stesso tema aziendale, ingombro ridotto. -->
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="FontSize" Value="12"/></Style>
  <!-- Riga di input compatta: etichetta a sinistra, campo giallo a larghezza fissa, unità allineata. -->
  <DataTemplate x:Key="WallField">
   <Border x:Name="Row" Padding="4,2" CornerRadius="2" Background="Transparent">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" Foreground="#344A5C"/>
     <TextBox Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" MinHeight="26" Padding="5,2" HorizontalContentAlignment="Right" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Error}"/>
     <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center" FontSize="11" Foreground="#526778" Margin="6,0,0,0"/>
    </Grid>
   </Border>
   <DataTemplate.Triggers><Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF0F1"/></Trigger></DataTemplate.Triggers>
  </DataTemplate>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="14,6"/></Style>
  <Style x:Key="Kpi" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="KpiLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#526778"/></Style>
 </ResourceDictionary></Window.Resources>
 <DockPanel x:Name="WallLayout" Margin="12" Background="#F3F6F6">
  <!-- Intestazione su una sola riga: titolo, comandi, logo. -->
  <Grid DockPanel.Dock="Top" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Muro di sostegno" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Geometria, terreno e azione sismica · risultati aggiornati a ogni modifica" Foreground="#526778" FontSize="11"/></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center">
    <Button Style="{StaticResource ToolButton}" Content="Carica esempio" Command="{Binding ExampleCommand}"/><Button Style="{StaticResource ToolButton}" Content="Apri" Command="{Binding OpenCommand}" ToolTip="Apri progetto JSON o .mdst"/><Button Style="{StaticResource ToolButton}" Content="Salva" Command="{Binding SaveCommand}" ToolTip="Salva progetto JSON"/><Button Style="{StaticResource ToolButton}" Content="Salva .mdst" Command="{Binding SaveMdstCommand}"/>
    <Button Style="{StaticResource ToolButton}" Content="Ricalcola" Command="{Binding CalculateCommand}" Background="#192845" BorderBrush="#192845" ToolTip="Il calcolo è automatico; il pulsante lo riesegue"/>
    <Button Style="{StaticResource ToolButton}" Content="Esporta risultati" Command="{Binding ExportCommand}"/><Button Style="{StaticResource ToolButton}" Content="Esporta JSON" Command="{Binding ExportJsonCommand}"/><Button Style="{StaticResource ToolButton}" Content="Relazione Word" Command="{Binding WordReportCommand}" ToolTip="Relazione di calcolo con normativa, formule compilate e figure"/><Button Style="{StaticResource ToolButton}" Content="Relazione PDF" Command="{Binding PdfReportCommand}"/>
   </WrapPanel>
   <Image Grid.Column="2" Source="/STA.Calcolo.Desktop;component/Assets/Brand/Logo.png" Stretch="Uniform" Height="38" Margin="12,0,0,0"/>
  </Grid>
  <Border DockPanel.Dock="Bottom" Padding="10,5" Background="#EAF0F1" Margin="0,8,0,0"><TextBlock Text="{Binding Status}" Foreground="#526778" TextWrapping="Wrap" FontSize="11.5"/></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="270"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="8"/><ColumnDefinition Width="262" MinWidth="220"/></Grid.ColumnDefinitions>
   <!-- Colonna dati: gruppi richiudibili e righe compatte. -->
   <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
    <Border Style="{StaticResource Panel}" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Progetto" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,10,0"/><TextBox Grid.Column="1" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="5,2" AutomationProperties.Name="Nome del progetto"/></Grid></Border>
    <!-- Parametri sismici dal modulo spettri: restituisce amax/g dello stato limite scelto nel campo PGA. -->
    <Border Style="{StaticResource Panel}" Padding="8" Margin="0,0,0,8"><StackPanel>
     <Button x:Name="SeismicFromSpectraButton" Content="Parametri sismici dagli spettri…" Command="{Binding SeismicFromSpectraCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
     <TextBlock Text="{Binding SeismicSourceText}" TextWrapping="Wrap" FontSize="11" Foreground="#526778"/>
    </StackPanel></Border>
    <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,8">
      <Expander IsExpanded="True" Padding="6,4,6,6">
       <Expander.Header><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#192845" Margin="2,4"/></Expander.Header>
       <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource WallField}"/>
      </Expander>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
   <TabControl x:Name="WallTabs" Grid.Column="2" Foreground="#192845" Background="White" BorderBrush="#D6E0E2">
    <TabItem Header="Sezione"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="2,0,0,6">
      <TextBlock TextWrapping="Wrap" Foreground="#526778" FontSize="11.5">Trascinare i quadratini per modificare la geometria: i campi e i risultati si aggiornano subito. Passo 5 cm, 1 cm con Ctrl · Esc annulla.</TextBlock>
      <!-- Scelta della combinazione disegnata e livelli visibili; disponibili con il motore rivisto. -->
      <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding HasResults}">
       <TextBlock Text="Combinazione" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox x:Name="DrawingCaseSelector" ItemsSource="{Binding DrawingCases}" SelectedItem="{Binding DrawingCase}" MinWidth="200" MinHeight="26" Padding="6,2" Margin="0,0,14,0" AutomationProperties.Name="Combinazione disegnata"/>
       <CheckBox Content="Forze" IsChecked="{Binding ShowForces}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <CheckBox Content="Diagrammi delle pressioni" IsChecked="{Binding ShowDiagrams}" VerticalAlignment="Center"/>
      </WrapPanel>
     </StackPanel>
     <ui:RetainingWallDrawing x:Name="WallFigure" Grid.Row="1" Geometry="{Binding Geometry}" Pressures="{Binding Pressures}" Forces="{Binding DrawingForces}" Diagrams="{Binding DrawingDiagrams}" ShowForces="{Binding ShowForces}" ShowDiagrams="{Binding ShowDiagrams}" Grips="{Binding Grips}" GripCommand="{Binding GripCommand}" Parameters="{Binding ByKey}" MinHeight="240" ClipToBounds="True"/>
     <WrapPanel Grid.Row="2" Margin="2,6,0,0"><TextBlock Text="■ Muro" Foreground="#135F6E" Margin="0,0,14,0"/><TextBlock Text="■ Terreno" Foreground="#7B6341" Margin="0,0,14,0"/><TextBlock Text="━ Falda" Foreground="#226BA0" Margin="0,0,14,0"/><TextBlock Text="■ σa spinta attiva" Foreground="#A35B18" Margin="0,0,14,0"/><TextBlock Text="■ σp resistenza passiva" Foreground="#2E7D4F" Margin="0,0,14,0"/><TextBlock Text="■ σ terreno di fondazione" Foreground="#6B4C9A" Margin="0,0,14,0"/><TextBlock Text="→ forze G · Q · sisma" Foreground="#192845" Margin="0,0,14,0"/><TextBlock Text="□ Grip modificabile" Foreground="#C3872A"/></WrapPanel>
    </Grid></TabItem>
    <TabItem Header="Risultati"><DockPanel Margin="8"><TextBlock DockPanel.Dock="Top" Text="{Binding ResultStatus}" Foreground="#526778" TextWrapping="Wrap" Margin="2,0,0,6"/><DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" MinRowHeight="26"><DataGrid.Columns><DataGridTextColumn Header="Grandezza" Binding="{Binding Label}" Width="2.5*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6,3"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Statica" Binding="{Binding Static}" Width="*" MinWidth="100"/><DataGridTextColumn Header="Sisma" Binding="{Binding Seismic}" Width="*" MinWidth="90"/><DataGridTextColumn Header="Unità" Binding="{Binding Unit}" Width="0.8*" MinWidth="80"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="Note di calcolo"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><ItemsControl ItemsSource="{Binding Notes}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF5E5" BorderBrush="#BC8135" BorderThickness="3,0,0,0" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="19"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="I file .mdst mantengono le chiavi del programma originale. Il formato JSON conserva anche il nome del progetto. I risultati sono ricalcolati a ogni modifica; con dati non validi l'esportazione è disabilitata." TextWrapping="Wrap" Foreground="#526778" LineHeight="19"/></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
   <!-- Sintesi sempre visibile: si aggiorna mentre si digita o si trascina un grip. -->
   <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,8"><StackPanel>
     <TextBlock Text="Sintesi" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Motore di calcolo" Style="{StaticResource KpiLabel}" Margin="0,0,0,3"/>
     <ComboBox x:Name="EngineSelector" ItemsSource="{Binding Engines}" DisplayMemberPath="Label" SelectedValuePath="Engine" SelectedValue="{Binding Engine}" Margin="0,0,0,10" AutomationProperties.Name="Motore di calcolo"/>
     <!-- Riquadri di verifica: verde se Rd/Ed ≥ 1, rosso se < 1, neutro per i rapporti del motore originale. -->
     <ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Label}" Style="{StaticResource KpiLabel}"/>
       <UniformGrid Columns="2">
        <Border x:Name="StaticTile" Background="#EAF0F1" CornerRadius="3" Padding="6,3" Margin="0,2,4,0"><StackPanel><TextBlock Text="Statica" FontSize="10" Foreground="#526778"/><TextBlock Text="{Binding Static}" Style="{StaticResource Kpi}"/></StackPanel></Border>
        <Border x:Name="SeismicTile" Background="#EAF0F1" CornerRadius="3" Padding="6,3" Margin="4,2,0,0"><StackPanel><TextBlock Text="Sisma" FontSize="10" Foreground="#526778"/><TextBlock Text="{Binding Seismic}" Style="{StaticResource Kpi}"/></StackPanel></Border>
       </UniformGrid></StackPanel>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding StaticOk}" Value="True"><Setter TargetName="StaticTile" Property="Background" Value="#E3F1E6"/></DataTrigger>
       <DataTrigger Binding="{Binding StaticOk}" Value="False"><Setter TargetName="StaticTile" Property="Background" Value="#FBE9E7"/></DataTrigger>
       <DataTrigger Binding="{Binding SeismicOk}" Value="True"><Setter TargetName="SeismicTile" Property="Background" Value="#E3F1E6"/></DataTrigger>
       <DataTrigger Binding="{Binding SeismicOk}" Value="False"><Setter TargetName="SeismicTile" Property="Background" Value="#FBE9E7"/></DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Area sezione muro" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding AreaText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <!-- Messaggio di errore evidenziato solo quando i dati non sono validi. -->
     <Border Background="#FBE9E7" BorderBrush="#B3261E" BorderThickness="3,0,0,0" Padding="8" Margin="0,0,0,10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InputsValid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding InputError}" TextWrapping="Wrap" Foreground="#7A1A14"/></Border>
     <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock Text="Grandezza" Style="{StaticResource KpiLabel}"/><TextBlock Grid.Column="1" Text="Statica" Style="{StaticResource KpiLabel}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="Sisma" Style="{StaticResource KpiLabel}" HorizontalAlignment="Right"/></Grid>
     <ItemsControl ItemsSource="{Binding Summary}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#DFE8EA" BorderThickness="0,1,0,0" Padding="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
       <TextBlock TextWrapping="Wrap"><Run Text="{Binding Label,Mode=OneWay}"/><Run Text="{Binding Unit,Mode=OneWay,StringFormat=' {0}'}" FontSize="10" Foreground="#7A8C99"/></TextBlock>
       <TextBlock Grid.Column="1" Text="{Binding Static}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Seismic}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
      </Grid></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{Binding ResultStatus}" TextWrapping="Wrap" Foreground="#526778" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border Background="#FFF5E5" BorderBrush="#BC8135" BorderThickness="3,0,0,0" Padding="10"><TextBlock Text="Verifiche di ribaltamento e scorrimento (NTC 2018). Esclusi capacità portante, stabilità globale, cedimenti e armature: consultare le note di calcolo." TextWrapping="Wrap" FontSize="11.5"/></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
