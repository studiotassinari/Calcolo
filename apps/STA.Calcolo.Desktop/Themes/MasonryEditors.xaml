<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Tassinari.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/><DataTemplate x:Key="Field"><StackPanel Margin="0,0,8,4"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#526778" TextWrapping="Wrap" Margin="0,0,0,2"/><Grid><TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasChoices,Converter={StaticResource Visible}}"/></Grid></StackPanel></DataTemplate><Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Background" Value="#EAF0F1"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,6,0,4"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style></ResourceDictionary>