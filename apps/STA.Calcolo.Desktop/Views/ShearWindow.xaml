<Window x:Class="STA.Calcolo.Desktop.Views.ShearWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views"
 Title="TA-Calcolo · Taglio sezioni in c.a." Width="1320" Height="900" MinWidth="920" MinHeight="660">
 <Window.Resources>
  <DataTemplate x:Key="NumberField">
   <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
    <TextBox Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" TextAlignment="Right"
     AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Error}"/>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <DockPanel Margin="24">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Taglio · sezioni in c.a." FontSize="27" FontWeight="SemiBold"/>
    <TextBlock Text="Travi e pareti rettangolari · staffe e ferri piegati" Foreground="#526778" Margin="0,5,0,0"/></StackPanel>
   <Image Grid.Column="1" Source="/STA.Calcolo.Desktop;component/Assets/Brand/Logo.png" Stretch="Uniform" Margin="18,0,0,0"/>
  </Grid>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <Button Content="Apri JSON / .tgl" Command="{Binding OpenCommand}"/>
   <Button Content="Salva progetto" Command="{Binding SaveCommand}"/>
   <Button Content="Calcola" Command="{Binding CalculateCommand}" Background="{DynamicResource BrandNavy}"/>
   <Button Content="Applica θ proposto" Command="{Binding SuggestCommand}"/>
   <Button Content="Relazione Word" Command="{Binding WordCommand}"/>
   <Button Content="Esporta risultati" Command="{Binding ExportCommand}"/>
  </WrapPanel>
  <Border DockPanel.Dock="Bottom" Background="#EAF0F1" Padding="10" Margin="0,12,0,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="Dati del progetto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Titolo" FontSize="11"/><TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
      <TextBlock Text="Tipologia" FontSize="11"/><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,4,0,10"/>
      <TextBlock Text="Modello del programma originale" FontSize="11"/><ComboBox ItemsSource="{Binding Standards}" SelectedItem="{Binding Standard}" Margin="0,4,0,4"/>
      <TextBlock Text="01 / GEOMETRIA" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Geometry}" ItemTemplate="{StaticResource NumberField}"/>
      <TextBlock Text="H è la dimensione resistente nel piano del taglio. Per le pareti rappresenta la lunghezza in pianta, non l'altezza di piano. La distanza dell'armatura è misurata al suo baricentro." TextWrapping="Wrap" FontSize="11" Foreground="#526778" Margin="0,0,0,8"/>
      <TextBlock Text="02 / SOLLECITAZIONI" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Loads}" ItemTemplate="{StaticResource NumberField}"/>
      <TextBlock Text="03 / MATERIALI" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Materials}" ItemTemplate="{StaticResource NumberField}"/>
      <TextBlock Text="04 / STAFFE" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Stirrups}" ItemTemplate="{StaticResource NumberField}"/>
      <TextBlock Text="05 / FERRI PIEGATI" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding BentBars}" ItemTemplate="{StaticResource NumberField}"/>
      <TextBlock Text="06 / BIELLE" Style="{StaticResource SectionLabel}"/>
      <ContentControl Content="{Binding ByKey[Theta]}" ContentTemplate="{StaticResource NumberField}"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <DockPanel Grid.Column="2">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Panel}" Margin="0,0,6,0"><StackPanel>
      <TextBlock Text="RESISTENZA DELLA CONFIGURAZIONE" FontSize="10" TextWrapping="Wrap" Foreground="#526778"/>
      <TextBlock Text="{Binding CapacityText}" FontSize="27" FontWeight="SemiBold" Margin="0,6"/>
      <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0,0,0"><StackPanel>
      <TextBlock Text="UTILIZZO VEd / VRd" FontSize="10" Foreground="#526778"/>
      <TextBlock Text="{Binding UtilizationText}" FontSize="27" FontWeight="SemiBold" Margin="0,6">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#526778"/><Style.Triggers>
        <DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Foreground" Value="#A84631"/></DataTrigger>
        <DataTrigger Binding="{Binding Passed}" Value="True"><Setter Property="Foreground" Value="#135F6E"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding SuggestedText,StringFormat='Proposta θ: {0}'}" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel></Border>
    </Grid>
    <Border DockPanel.Dock="Bottom" Background="#FFF5E5" BorderBrush="#BC8135" BorderThickness="3,0,0,0" Padding="10" Margin="0,12,0,0">
     <TextBlock Text="{Binding MethodNote}" TextWrapping="Wrap" FontSize="11"/>
    </Border>
    <TabControl x:Name="DetailTabs" Background="White" BorderBrush="#D6E0E2" Padding="12">
     <TabItem Header="  Sezione e quote  ">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding FigureCaption}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,6"/>
        <TextBlock Text="Modifica i valori nelle quote gialle: figura e campi si aggiornano insieme." Foreground="#526778" TextWrapping="Wrap" Margin="0,0,0,8"/>
       </StackPanel>
       <views:ShearSectionView x:Name="SectionFigure"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="  Risultati di calcolo  ">
      <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Grandezza" Binding="{Binding Grandezza}" Width="*"/>
        <DataGridTextColumn Header="Valore" Binding="{Binding Valore,StringFormat=N3}" Width="110"/>
        <DataGridTextColumn Header="Unità" Binding="{Binding Unità}" Width="60"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
